---
const { t } = Astro.props;
---

<section id="skills">
    <div class="container">
        <h1> {t.skills.title} </h1>
        <p class="skills-subtitle">{t.skills.iWorkWith}</p>
        <div class="skills-grid">
            {t.skills.list.map((skill: string) => (
                <div class="skill d-flex">{skill}</div>
            ))}
        </div>
    </div>
</section>

<style>
    h1 {
        color: var(--highlight);
    }

    .skills-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 1rem;
    }

    .skill {
        border: 1px solid var(--border-subtle);
        padding: 0.8rem 1rem;
        border-radius: 10px;
        text-align: center;
        font-size: var(--fs-sm);
        background: var(--surface);
        transition: background 0.2s ease, border-color 0.2s ease;
        min-height: 60px;
    }

    .skills-subtitle {
        color: var(--link);
        margin-top: 0.5rem;
    }
</style>