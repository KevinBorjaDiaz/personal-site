---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/wordle.css";
import { en, es } from "../../../Resources";
import type { Language } from "../../../types/language.type";

export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang as Language;
const t = { en, es }[lang];
---

<BaseLayout lang={lang} t={t}>
  <section class="d-flex column container">
    <a href={`/${lang}/projects`} class="back-btn">← {t.projects.back}</a>
    <div id="game"></div>

    <p id="error" class="error"></p>

    <div id="keyboard"></div>

    <div class="controls">
      <label>{t.projects.wordle.language}:</label>
      <select id="language">
        <option value="EN">{t.projects.wordle.english}</option>
        <option value="ES">{t.projects.wordle.spanish}</option>
      </select>

      <label>{t.projects.wordle.length}:</label>
      <select id="length">
        <option value="5">5</option>
        <option value="7">7</option>
      </select>
    </div>
  </section>
</BaseLayout>

<script type="module" src="/src/utils/wordle/game.js"></script>