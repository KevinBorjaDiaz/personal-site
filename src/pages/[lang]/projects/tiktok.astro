---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { en, es } from "../../../Resources";
import type { Language } from "../../../types/language.type";

export async function getStaticPaths() {
  return [{ params: { lang: "en" } }, { params: { lang: "es" } }];
}

const lang = Astro.params.lang as Language;
const t = { en, es }[lang];
const base = import.meta.env.BASE_URL;
---
<BaseLayout lang={lang} t={t}>

  <div class="d-flex column container">
    <div id="error" class="error hidden errorBanner"></div>
    
    <div class="d-flex gap-2 end">
      <a href={`${base}${lang}/projects`} class="back-btn">← {t.projects.back}</a>

      <div>
        <input
        type="text"
        placeholder={t.projects.tiktok.placeholder}
        id="tiktokURL"
        autocomplete="off"
        />
        
        <button id="goBtn" type="button" class="btn btn-secondary">{t.projects.tiktok.search}</button>
      </div>
    </div>
    
    <blockquote>
      <iframe
        id="iframe"
        width="100%"
        height="575"
        allowfullscreen
        class="hidden"></iframe>
    </blockquote>
      


    <div class="d-flex column btnDiv">
      <button id="copyBtn" class="hidden btn btn-secondary bigbtn">{t.projects.tiktok.copyUrl}</button>
      <a id="goLink" target="_blank" class="hidden bigbtn">
        <button class="btn btn-secondary bigbtn">{t.projects.tiktok.goToUrl}</button>
      </a>
    </div>  
  </div>
</BaseLayout>

<script>
  
  const el = {
    input: document.getElementById("tiktokURL") as HTMLInputElement,
    goBtn: document.getElementById("goBtn") as HTMLButtonElement,
    iframe: document.getElementById("iframe") as HTMLIFrameElement,
    error: document.getElementById("error") as HTMLElement,
    copyBtn: document.getElementById("copyBtn") as HTMLButtonElement,
    goLink: document.getElementById("goLink") as HTMLAnchorElement,
  };

  let strURL: string | null = null;

  el.goBtn.addEventListener("click", async () => {
    const text = el.input.value.trim();
    const resolved = await callApiForMobileURL(text);
    validateText(resolved);
  });

  el.input.addEventListener("paste", async (e: ClipboardEvent) => {
    const text = e.clipboardData?.getData("text").trim() || "";
    const resolved = await callApiForMobileURL(text);
    validateText(resolved);
  });

  function validateText(text: string | null) {
    if (!text) {
      setView("TikTok URL not accessible or restricted", false, "");
      return;
    }
    prepareURL(text);
  }

  function setView(
    errorMsg: string | null,
    showBtns: boolean,
    url: string | null,
  ) {
    strURL = url;

    el.error.textContent = errorMsg || "";
    el.error.classList.toggle("hidden", !errorMsg);

    el.copyBtn.classList.toggle("hidden", !showBtns);
    el.goLink.classList.toggle("hidden", !showBtns);
    el.iframe.classList.toggle("hidden", !showBtns);
  }

  function prepareURL(text: string) {
    try {
      const parsed = new URL(text);
      const paths = parsed.pathname.split("/");

      if (paths.length >= 4) {
        const videoID = paths[3];
        const finalURL = `https://www.tiktok.com/embed/${videoID}`;

        el.iframe.src = finalURL;
        el.goLink.href = finalURL;

        setView(null, true, finalURL);
        return;
      }
    } catch {}

    setView("TikTok URL not accessible or restricted", false, "");
  }

  async function callApiForMobileURL(text: string) {
    const url = `https://www.tiktok.com/oembed?url=${text}`;

    try {
      const res = await fetch(url);
      if (!res.ok) throw new Error();

      const data = await res.json();
      return `${data.author_url}/v/${data.embed_product_id}`;
    } catch {
      return null;
    }
  }

  el.copyBtn.addEventListener("click", () => {
    if (strURL) navigator.clipboard.writeText(strURL);
  });
</script>

<style>

  .hidden {
    display: none;
  }

  .error {
    color: var(--bs-danger-text-emphasis);
  }

  .bigbtn, .btnDiv {
    width: 100%;
  }

  #goBtn {
    padding:0.1rem 1.5rem;
  }

  .end {
    align-items: flex-end;
  }

  .errorBanner{
    background-color: var(--bs-danger-bg-subtle);
    border: 1px solid var(--bs-danger-border-subtle);
    padding: 1rem;
    margin-bottom: 1rem;
    border-radius: 0.375rem;
    width: 100%;
    font-family: var(--font-main);
    font-size: var(--fs-md)
  }

  @media (max-width: 768px) {
    .end {
      align-items: flex-start;
    }
  }
</style>
